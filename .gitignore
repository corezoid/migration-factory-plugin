# Binaries. bin/ is build output, except the release binaries the plugin ships:
# a host with no Go toolchain (a container) can start the server only from one
# of those, so they are committed. `make -C server release` rebuilds them.
bin/*
!bin/migration-factory-plugin-mcp-linux-amd64
!bin/migration-factory-plugin-mcp-linux-arm64
*.exe
*.exe~
*.dll
*.so
*.dylib

# Test artifacts
coverage.out
*.test

# credentials the server's make targets read (SIM_BASE_URL / SIM_API_KEY)
server/.env
.env

# IDE
.idea/
.vscode/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# the Claude Code harness's own local state — settings, worktrees, ad hoc skills —
# never meant to be shared
.claude/
.playwright-mcp/

# a session's own debug output: full run transcripts (real document content can end
# up in these) and ad hoc screenshots taken while testing
session-run_*.json
img_1.png
preview-1.png

# Binaries. bin/ is build output — the Go server this once shipped compiled
# release binaries here for a toolchain-less host; the Python server that
# replaced it ships as source plus vendor/ instead, so nothing here is
# committed any more.
bin/*
*.exe
*.exe~
*.dll
*.so
*.dylib

# Test artifacts
coverage.out
*.test
__pycache__/
*.pyc
*.egg-info/
.pytest_cache/
server/.venv/

# credentials the server's make targets read (SIM_BASE_URL / SIM_API_KEY)
server/.env
.env

# IDE
.idea/
.vscode/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# the Claude Code harness's own local state — settings, worktrees, ad hoc skills —
# never meant to be shared
.claude/
.playwright-mcp/

# a session's own debug output: full run transcripts (real document content can end
# up in these) and ad hoc screenshots taken while testing
session-run_*.json
img_1.png
preview-1.png

#!/bin/sh
# Launcher for the migration-factory-plugin MCP server (Python).
#
# Unlike the Go version this replaces, there is no per-platform binary to
# pick: Python is interpreted, so the package under server/ runs as-is on
# any host with a python3 interpreter. The only thing that varies by
# platform is which vendored wheel bundle (bundled for a host with no
# pip/network, such as the Hermes container) to put on PYTHONPATH.
#
# It exists as a script rather than a command line in .mcp.json because of
# the things such a line cannot do itself:
#
#   1. the real working directory has to be handed over in
#      MIGRATION_FACTORY_PLUGIN_CWD before `python3 -m` changes it out from
#      under a relative path in a tool call;
#   2. picking an interpreter has to fall back through a short list of
#      common install locations, because the client launches this from its
#      own environment, not from a login shell, so PATH may be missing
#      everything a terminal has.
#
# stdout is the MCP protocol: everything this script says goes to stderr.
set -eu

here=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)

say() { printf 'migration-factory-plugin: %s\n' "$1" >&2; }

# The directory the client started us in, so a relative path in a tool call
# resolves against the user's project rather than against this package.
: "${MIGRATION_FACTORY_PLUGIN_CWD:=$(pwd)}"
export MIGRATION_FACTORY_PLUGIN_CWD

# An explicit interpreter wins over everything and is never silently
# skipped: a host that names one means it.
if [ -n "${MIGRATION_FACTORY_PLUGIN_PYTHON:-}" ]; then
	if [ -x "${MIGRATION_FACTORY_PLUGIN_PYTHON}" ] || command -v "${MIGRATION_FACTORY_PLUGIN_PYTHON}" >/dev/null 2>&1; then
		python_bin="${MIGRATION_FACTORY_PLUGIN_PYTHON}"
	else
		say "MIGRATION_FACTORY_PLUGIN_PYTHON=${MIGRATION_FACTORY_PLUGIN_PYTHON} is not an executable"
		exit 1
	fi
else
	find_python() {
		for candidate in python3.13 python3.12 python3.11 python3.10 python3; do
			if command -v "$candidate" >/dev/null 2>&1; then
				command -v "$candidate"
				return 0
			fi
		done
		for candidate in \
			/usr/bin/python3 \
			/usr/local/bin/python3 \
			/opt/homebrew/bin/python3 \
			"${HOME:-}/.local/bin/python3"; do
			if [ -x "$candidate" ]; then
				printf '%s\n' "$candidate"
				return 0
			fi
		done
		return 1
	}
	python_bin=$(find_python) || {
		say "no python3 interpreter found on this host"
		say "install Python 3.10+: https://www.python.org/downloads/"
		exit 1
	}
fi

# The platform, matching the vendor/ directory naming convention (mirrors
# the bin/migration-factory-plugin-mcp-$goos-$goarch naming the Go version
# used, so the deploy story — commit one bundle per platform for a host
# with no network — stays the same shape).
goos=$(uname -s | tr 'ABCDEFGHIJKLMNOPQRSTUVWXYZ' 'abcdefghijklmnopqrstuvwxyz')
case $(uname -m) in
x86_64 | amd64) goarch=amd64 ;;
aarch64 | arm64) goarch=arm64 ;;
*) goarch=$(uname -m) ;;
esac
vendor_dir="$here/vendor/$goos-$goarch"

pythonpath="$here/server${PYTHONPATH:+:$PYTHONPATH}"
# The vendored bundle is used unless a developer asked for the environment's
# own install (MIGRATION_FACTORY_PLUGIN_FROM_SOURCE=1 — e.g. an editable
# `pip install -e .`, where the vendor bundle would shadow it).
if [ -d "$vendor_dir" ] && [ -z "${MIGRATION_FACTORY_PLUGIN_FROM_SOURCE:-}" ]; then
	pythonpath="$vendor_dir:$pythonpath"
fi
export PYTHONPATH="$pythonpath"

exec "$python_bin" -m migration_factory_plugin_mcp "$@"
